<%- include('partials/payroll-layout-start', { payNavActive: 'admin-activity' }) %>
<%
var rows = activityRows || [];
var _fmtWhen = function (v) {
  if (!v) return '—';
  var d = new Date(v);
  if (isNaN(d.getTime())) return String(v);
  return d.toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
};
var _actionLabel = function (a) {
  return String(a || '').replace(/[._]/g, ' ').replace(/\b\w/g, function (ch) { return ch.toUpperCase(); });
};
%>

<div class="sage-page-head">
  <div>
    <p class="sage-eyebrow">Administration &middot; Audit</p>
    <h1>Admin activity</h1>
    <p class="sage-sub">A record of account, role and security changes. Entries are written by the server and cannot be edited from the app.</p>
  </div>
  <div class="sage-head-actions no-print">
    <a href="/admin" class="btn btn-sage-ghost"><i class="fa fa-dashboard mr-1"></i> Overview</a>
  </div>
</div>

<%- include('partials/admin-tabs') %>

<section class="sage-card">
  <div class="sage-card-head">
    <div><h2>Activity trail</h2><p class="sage-card-sub">Most recent 200 entries</p></div>
    <div class="pay-toolbar no-print">
      <input type="search" id="auditSearch" class="pay-search" placeholder="Filter actions, users or targets…" aria-label="Filter activity">
    </div>
  </div>
  <div class="pay-table-wrap">
    <table class="pay-table" id="auditTable">
      <thead>
        <tr><th>When</th><th>Administrator</th><th>Action</th><th>Target</th><th>Detail</th><th>IP</th></tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
        <tr><td colspan="6" class="sage-empty"><i class="fa fa-history"></i>No admin activity recorded yet. Changes made in Administration will appear here.</td></tr>
        <% } %>
        <% rows.forEach(function (a) { %>
        <tr>
          <td class="sage-muted" style="white-space:nowrap; font-size:12px;"><%= _fmtWhen(a.created_at) %></td>
          <td>
            <span class="audit-actor"><%= a.actor_name || 'System' %></span>
            <% if (a.actor_username) { %><small class="d-block text-muted">@<%= a.actor_username %></small><% } %>
          </td>
          <td><span class="pay-badge"><%= _actionLabel(a.action) %></span></td>
          <td class="sage-mono" style="font-size:12px;"><%= a.target_type ? a.target_type + ' ' + (a.target_id || '') : '—' %></td>
          <td style="font-size:12.5px;"><%= a.detail || '' %></td>
          <td class="sage-mono" style="font-size:11.5px;"><%= a.ip_address || '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <div class="sage-card-foot">
    <span class="sage-muted" style="font-size:12px;">Admins can export this list from the database table <span class="sage-mono">tbl_admin_audit</span>.</span>
    <span class="sage-muted" style="font-size:12px;" id="auditCount"><%= rows.length %> entries</span>
  </div>
</section>

<script>
(function () {
  var input = document.getElementById('auditSearch');
  var table = document.getElementById('auditTable');
  if (!input || !table) return;
  var rows = Array.prototype.slice.call(table.tBodies[0].rows);
  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var shown = 0;
    rows.forEach(function (row) {
      var hit = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
      row.style.display = hit ? '' : 'none';
      if (hit) shown++;
    });
    var out = document.getElementById('auditCount');
    if (out) out.textContent = shown + ' entries';
  });
})();
</script>

<%- include('partials/payroll-layout-end') %>
