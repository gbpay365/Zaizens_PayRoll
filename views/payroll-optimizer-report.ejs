<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<link rel="stylesheet" href="/css/font-awesome.min.css">
<style>
  * { box-sizing: border-box; }
  body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 0; padding: 24px; color: #0f172a; background: #f8fafc; }
  .toolbar { max-width: 1040px; margin: 0 auto 18px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .toolbar a, .toolbar button { border: 1px solid #cbd5e1; background: #fff; color: #0f172a; border-radius: 8px; padding: 9px 14px; font-weight: 600; cursor: pointer; text-decoration: none; font-size: 13px; }
  .toolbar button.primary { background: #0d2137; color: #fff; border-color: #0d2137; }
  .toolbar .spacer { flex: 1; }
  .page { max-width: 1040px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 28px; }
  .letterhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; border-top: 4px solid #0d2137; padding-bottom: 16px; margin-bottom: 4px; }
  .letterhead-brand { display: flex; align-items: center; gap: 12px; }
  .letterhead-logo { width: 44px; height: 44px; border-radius: 9px; display: block; }
  .letterhead-name { font-size: 19px; font-weight: 800; letter-spacing: .02em; color: #0d2137; }
  .letterhead-tag { font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #8a7440; margin-top: 3px; }
  .letterhead-doc { text-align: right; }
  .letterhead-title { font-size: 14px; font-weight: 800; color: #0d2137; }
  .letterhead-meta { font-size: 11.5px; color: #64748b; margin-top: 3px; }

  .status-strip { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin: 18px 0 14px; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 9px; background: #f8fafc; }
  .status-strip .who { font-size: 15px; font-weight: 800; }
  .status-strip .sub { font-size: 11.5px; color: #64748b; margin-top: 2px; }
  .badge { display: inline-block; padding: 4px 9px; border-radius: 999px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
  .badge.ok { background: #dcfce7; color: #166534; }
  .badge.warn { background: #fef3c7; color: #92400e; }
  .badge.bad { background: #fee2e2; color: #991b1b; }
  .badge.info { background: #e0f2fe; color: #0369a1; }
  .badge.muted { background: #f1f5f9; color: #475569; }

  h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: #475569; margin: 24px 0 8px; padding-bottom: 5px; border-bottom: 1px solid #e2e8f0; }
  .meta-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px 18px; font-size: 11.5px; }
  .meta-grid .lbl { color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; }
  .meta-grid .val { font-weight: 700; color: #1e293b; margin-top: 2px; }

  .summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 9px; margin: 12px 0; }
  .summary-card { border: 1px solid #e2e8f0; border-radius: 8px; padding: 9px 11px; background: #f8fafc; }
  .summary-card .label { font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: .04em; }
  .summary-card .value { font-size: 16px; font-weight: 800; margin-top: 3px; font-variant-numeric: tabular-nums; }
  .summary-card.good .value { color: #15803d; }
  .summary-card.bad .value { color: #b91c1c; }

  table { width: 100%; border-collapse: collapse; font-size: 11.5px; margin-top: 8px; }
  th, td { border: 1px solid #cbd5e1; padding: 6px 8px; text-align: left; vertical-align: top; }
  th { background: #f1f5f9; font-weight: 700; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; color: #475569; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td .small { font-size: 10px; color: #64748b; margin-top: 3px; line-height: 1.4; }
  td .small em { color: #475569; }
  tr.total td { font-weight: 800; background: #f8fafc; }
  .empty { font-size: 11.5px; color: #64748b; padding: 10px 0; }
  .signatures { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 44px; }
  .sig-box { border-top: 1px solid #94a3b8; padding-top: 8px; min-height: 68px; font-size: 11px; color: #475569; }
  .footnote { margin-top: 22px; font-size: 10.5px; color: #64748b; line-height: 1.5; }
  @media (max-width: 820px) { .meta-grid, .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media print {
    @page { size: A4; margin: 12mm; }
    body { background: #fff; padding: 0; }
    .no-print { display: none !important; }
    .page { border: 0; border-radius: 0; padding: 0; max-width: none; }
    .summary-card, .status-strip, th, .badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    table, .summary-card, .status-strip { break-inside: avoid; }
    h2 { break-after: avoid; }
  }
</style>
</head>
<body>
<%
  var fmt = function (n) { return Number(n || 0).toLocaleString('fr-FR', { maximumFractionDigits: 0 }); };
  var labels = {
    transport: 'Transport', representation: 'Representation', housing: 'Housing',
    electricity: 'Electricity', water: 'Water', meal: 'Meal', dirtiness: 'Dirtiness',
    clothing: 'Work clothing', tools: 'Tools', other: 'Other allowances'
  };
  var allowanceKeys = ['transport', 'representation', 'housing', 'electricity', 'water', 'meal', 'dirtiness', 'clothing', 'tools', 'other'];
  var modeLabels = { employee: 'Employee net pay', employer: 'Employer cost', both: 'Employee + employer' };
  var statusLabel = evaluation.hasBlocking ? 'Blocked' : (evaluation.waivedCount ? 'Compliant with waivers' : 'Compliant');
  var statusClass = evaluation.hasBlocking ? 'bad' : (evaluation.waivedCount ? 'warn' : 'ok');
  var activeWaivers = (waiverHistory || []).filter(function (w) { return !w.revoked_at; });
  var revokedWaivers = (waiverHistory || []).filter(function (w) { return w.revoked_at; });
  var shortDate = function (v) {
    if (!v) return '—';
    var d = new Date(v);
    return isNaN(d.getTime()) ? String(v) : d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
  };
%>

<div class="toolbar no-print">
  <a href="/payroll/optimizer?employee_id=<%= encodeURIComponent(employee.id) %>"><i class="fa fa-arrow-left"></i> Back to optimizer</a>
  <span class="spacer"></span>
  <button type="button" class="primary" onclick="window.print()"><i class="fa fa-print"></i> Print / Save as PDF</button>
</div>

<div class="page">
  <%- include('partials/print-letterhead', {
    docTitle: 'Payroll Optimizer — Compliance & Waiver Audit',
    docNumber: 'Employee ' + (employee.matricule || employee.id),
    docDate: reportDate,
    accent: '#0d2137',
    tagline: (locals.company && locals.company.tagline) || 'Payroll & HR'
  }) %>

  <div class="status-strip">
    <div>
      <div class="who"><%= employee.name %></div>
      <div class="sub"><%= employee.matricule || employee.id %> · <%= result.profile.sectorLabel %> · CNPS regime <%= result.profile.regimeLabel %></div>
    </div>
    <div>
      <span class="badge <%= statusClass %>"><%= statusLabel %></span>
      <% if (evaluation.hasBlocking) { %><span class="badge bad" style="margin-left:5px;"><%= evaluation.blocking.length %> unresolved</span><% } %>
      <% if (evaluation.waivedCount) { %><span class="badge warn" style="margin-left:5px;"><%= evaluation.waivedCount %> waived</span><% } %>
    </div>
  </div>

  <h2>Scenario</h2>
  <div class="meta-grid">
    <div><div class="lbl">Base salary</div><div class="val"><%= fmt(form.baseSalary) %> XAF</div></div>
    <div><div class="lbl">Gross cash</div><div class="val"><%= fmt(result.grossCash) %> XAF</div></div>
    <div><div class="lbl">Sectoral SMIG</div><div class="val"><%= fmt(result.profile.smig) %> XAF</div></div>
    <div><div class="lbl">Optimization focus</div><div class="val"><%= modeLabels[form.mode] || modeLabels.both %></div></div>
    <div><div class="lbl">CNPS regime</div><div class="val"><%= result.profile.regimeLabel %></div></div>
    <div><div class="lbl">Occupational risk</div><div class="val"><%= result.profile.riskLabel %></div></div>
    <div><div class="lbl">Employer family rate</div><div class="val"><%= (result.rates.familyRate * 100).toFixed(2) %>%</div></div>
    <div><div class="lbl">Report generated</div><div class="val"><%= reportDate %></div></div>
  </div>

  <h2>Payroll summary</h2>
  <div class="summary-grid">
    <div class="summary-card"><div class="label">Gross cash</div><div class="value"><%= fmt(result.grossCash) %></div></div>
    <div class="summary-card"><div class="label">Gross taxable</div><div class="value"><%= fmt(result.grossTaxable) %></div></div>
    <div class="summary-card"><div class="label">CNPS contributory base</div><div class="value"><%= fmt(result.cnpsBase) %></div></div>
    <div class="summary-card <%= evaluation.hasBlocking ? 'bad' : 'good' %>"><div class="label">Net pay</div><div class="value"><%= fmt(result.netPay) %></div></div>
    <div class="summary-card"><div class="label">Employee deductions</div><div class="value"><%= fmt(result.employeeDeductions) %></div></div>
    <div class="summary-card"><div class="label">Employer contributions</div><div class="value"><%= fmt(result.employerContributions) %></div></div>
    <div class="summary-card"><div class="label">Total employer cost</div><div class="value"><%= fmt(result.totalEmployerCost) %></div></div>
    <div class="summary-card <%= evaluation.hasBlocking ? 'bad' : '' %>"><div class="label">Unresolved exceptions</div><div class="value"><%= evaluation.blocking.length %></div></div>
  </div>

  <h2>Compliance checks</h2>
  <% if (!evaluation.violations || !evaluation.violations.length) { %>
  <div class="empty">No statutory exception was detected for this scenario.</div>
  <% } else { %>
  <table>
    <thead><tr><th style="width:20%;">Code / severity</th><th>Exception and rule</th><th class="num">Amount</th><th class="num">Ceiling</th><th class="num">Excess</th><th>Status</th></tr></thead>
    <tbody>
      <% evaluation.violations.forEach(function (v) { %>
      <tr>
        <td><strong><%= v.code %></strong><div class="small"><%= v.severity %></div></td>
        <td>
          <strong><%= v.title %></strong>
          <div class="small"><%= v.message %></div>
          <div class="small"><em>Rule: <%= v.rule %></em></div>
        </td>
        <td class="num"><%= fmt(v.amount) %></td>
        <td class="num"><%= v.max != null ? fmt(v.max) : '—' %></td>
        <td class="num"><%= v.excess > 0 ? fmt(v.excess) : '—' %></td>
        <td>
          <% if (v.waived) { %>
            <span class="badge warn">Waived</span>
            <div class="small"><%= waiverReasons[v.waiver && v.waiver.reason] || (v.waiver && v.waiver.reason) || 'Approved' %><%= v.waiver && v.waiver.note ? ' — ' + v.waiver.note : '' %></div>
          <% } else if (v.blocking) { %>
            <span class="badge bad">Unresolved</span>
            <% if (!v.waivable) { %><div class="small">Critical — not waivable</div><% } %>
          <% } else { %>
            <span class="badge info">Informational</span>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>

  <h2>Pay structure</h2>
  <table>
    <thead><tr><th>Component</th><th class="num">Amount (XAF)</th><th class="num">Statutory ceiling</th></tr></thead>
    <tbody>
      <tr><td><strong>Base salary</strong></td><td class="num"><%= fmt(form.baseSalary) %></td><td class="num"><%= fmt(result.profile.smig) %> minimum</td></tr>
      <% allowanceKeys.forEach(function (key) { %>
        <% if (Number(result.allowances[key]) > 0) { %>
        <tr>
          <td><%= labels[key] %></td>
          <td class="num"><%= fmt(result.allowances[key]) %></td>
          <td class="num">
            <% if (key === 'transport' || key === 'representation') { %>400 000 combined<% } else if (key === 'other') { %>Fully taxable<% } else { %><%= fmt(result.caps[key]) %><% } %>
          </td>
        </tr>
        <% } %>
      <% }); %>
      <tr class="total"><td>Total gross cash</td><td class="num"><%= fmt(result.grossCash) %></td><td class="num"></td></tr>
    </tbody>
  </table>

  <h2>Payroll calculation</h2>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;">
    <table>
      <thead><tr><th>Employee deductions</th><th class="num">XAF</th></tr></thead>
      <tbody>
        <tr><td>CNPS pension (<%= (result.rates.pensionEmployeeRate * 100).toFixed(2) %>%)</td><td class="num"><%= fmt(result.pensionEmployee) %></td></tr>
        <tr><td>CFC — Crédit Foncier</td><td class="num"><%= fmt(result.cfcEmployee) %></td></tr>
        <tr><td>IRPP</td><td class="num"><%= fmt(result.irpp) %></td></tr>
        <tr><td>Council tax (TCL)</td><td class="num"><%= fmt(result.councilTax) %></td></tr>
        <tr><td>Audiovisual royalty (RAV)</td><td class="num"><%= fmt(result.rav) %></td></tr>
        <tr class="total"><td>Total employee deductions</td><td class="num"><%= fmt(result.employeeDeductions) %></td></tr>
        <tr class="total"><td>Net pay</td><td class="num"><%= fmt(result.netPay) %></td></tr>
      </tbody>
    </table>
    <table>
      <thead><tr><th>Employer contributions</th><th class="num">XAF</th></tr></thead>
      <tbody>
        <tr><td>CNPS pension (4.2%)</td><td class="num"><%= fmt(result.pensionEmployer) %></td></tr>
        <tr><td>Family allowances (<%= (result.rates.familyRate * 100).toFixed(2) %>%)</td><td class="num"><%= fmt(result.familyEmployer) %></td></tr>
        <tr><td>Occupational risks (<%= (result.rates.riskRate * 100).toFixed(2) %>%)</td><td class="num"><%= fmt(result.riskEmployer) %></td></tr>
        <tr><td>CFC employer</td><td class="num"><%= fmt(result.cfcEmployer) %></td></tr>
        <tr><td>FNE employer</td><td class="num"><%= fmt(result.fneEmployer) %></td></tr>
        <tr class="total"><td>Total employer contributions</td><td class="num"><%= fmt(result.employerContributions) %></td></tr>
        <tr class="total"><td>Total employer cost</td><td class="num"><%= fmt(result.totalEmployerCost) %></td></tr>
      </tbody>
    </table>
  </div>

  <h2>Waiver audit trail</h2>
  <div class="small" style="margin-bottom:6px;">
    <%= activeWaivers.length %> active waiver(s); <%= revokedWaivers.length %> revoked or superseded request(s).
  </div>
  <% if (!waiverHistory || !waiverHistory.length) { %>
  <div class="empty">No waiver has been recorded for this employee.</div>
  <% } else { %>
  <table>
    <thead><tr><th>Recorded</th><th>Exception</th><th class="num">Amount / ceiling</th><th>Reason and justification</th><th>Recorded by</th><th>Status</th></tr></thead>
    <tbody>
      <% waiverHistory.forEach(function (w) { %>
      <tr>
        <td><%= shortDate(w.created_at) %></td>
        <td><strong><%= String(w.violation_key || '').replace(/_/g, ' ') %></strong><div class="small"><%= w.violation_code %></div></td>
        <td class="num"><%= fmt(w.amount) %><div class="small">max <%= fmt(w.max_amount) %></div></td>
        <td><%= waiverReasons[w.reason] || w.reason %><%= w.note ? ' — ' + w.note : '' %></td>
        <td><%= w.created_by_name || 'Payroll user' %></td>
        <td>
          <% if (w.revoked_at) { %>
            <span class="badge muted">Revoked</span>
            <div class="small"><%= shortDate(w.revoked_at) %><%= w.revoked_reason ? ' — ' + w.revoked_reason : '' %></div>
          <% } else { %>
            <span class="badge warn">Active</span>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>

  <div class="signatures">
    <div class="sig-box">Prepared by (name &amp; signature)</div>
    <div class="sig-box">HR / Management approval (name, stamp &amp; signature)</div>
  </div>

  <p class="footnote">
    This report is an advisory compliance snapshot generated from the payroll optimizer. It does not create or modify payroll records, pay profiles or posted payroll runs.
    <% if (evaluation.hasBlocking) { %><strong style="color:#991b1b;">This scenario remains blocked by unresolved statutory exceptions.</strong><% } %>
  </p>
</div>
</body>
</html>
