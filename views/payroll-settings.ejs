    background: #f8fafc; border-bottom: 1px solid #e2e8f0;
    color: #475569; font-size: 0.65rem; font-weight: 800;
    letter-spacing: 0.055em; text-transform: uppercase; white-space: nowrap;
  }
  .allowance-settings .allowance-table tbody td { padding: 12px; vertical-align: middle; }
  .allowance-col-on { width: 48px; }
  .allowance-col-label { width: 24%; }
  .allowance-col-formula { width: 18%; }
  .allowance-col-rate { width: 18%; }
  .allowance-col-cap { width: 12%; }
  .allowance-col-legal { width: 26%; }

  .allowance-row-check { width: 16px; height: 16px; margin: 0; vertical-align: middle; cursor: pointer; accent-color: #059669; }
  .allowance-label-en { display: block; color: #0f172a; font-size: 0.8rem; font-weight: 700; line-height: 1.35; }
  .allowance-label-fr { display: block; margin-top: 2px; color: #64748b; font-size: 0.7rem; line-height: 1.35; }

  .allowance-settings .allowance-table .form-control {
    height: 32px; padding: 4px 8px; border-color: #cbd5e1; color: #0f172a; font-size: 0.8rem;
  }
  .allowance-settings .allowance-table .form-control:focus { border-color: #059669; box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.1); }
  .allowance-formula-select { padding-right: 24px !important; }
  .allowance-rate-fields { display: flex; flex-direction: column; gap: 5px; }
  .allowance-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .allowance-field[hidden], .allowance-auto-note[hidden] { display: none !important; }
  .allowance-rate-group { width: 100%; max-width: 190px; }
  .allowance-rate-group .form-control { min-width: 0; text-align: right; font-variant-numeric: tabular-nums; }
  .allowance-settings .allowance-table .input-group-text {
    padding: 4px 7px; border-color: #cbd5e1; background: #f8fafc;
    color: #475569; font-size: 0.65rem; font-weight: 700; white-space: nowrap;
  }
  .allowance-field-hint { color: #94a3b8; font-size: 0.65rem; line-height: 1.2; }
  .allowance-auto-note {
    display: inline-flex; align-items: center; gap: 6px; max-width: 190px;
    padding: 6px 8px; border: 1px dashed #cbd5e1; border-radius: 7px;
    background: #f8fafc; color: #64748b; font-size: 0.7rem; line-height: 1.25;
  }
  .allowance-auto-note .fa { color: #94a3b8; }
  .allowance-cap-group { max-width: 112px; }
  .allowance-settings .allowance-table .allowance-cap-group .form-control {
    min-width: 0; padding-left: 5px; padding-right: 5px;
    text-align: right; font-variant-numeric: tabular-nums;
  }
  .allowance-settings .allowance-table .allowance-cap-group input[type=number] {
    -moz-appearance: textfield; appearance: textfield;
  }
  .allowance-settings .allowance-table .allowance-cap-group input[type=number]::-webkit-outer-spin-button,
  .allowance-settings .allowance-table .allowance-cap-group input[type=number]::-webkit-inner-spin-button {
    -webkit-appearance: none; margin: 0;
  }
  .allowance-legal-input { font-size: 0.74rem !important; text-overflow: ellipsis; }
  .allowance-legal-text { display: block; color: #475569; font-size: 0.72rem; line-height: 1.4; overflow-wrap: anywhere; }
  .allowance-readonly-value { color: #0f172a; font-size: 0.8rem; font-weight: 700; font-variant-numeric: tabular-nums; }

  .allowance-footer {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    margin-top: 16px;
  }
  .allowance-footer-note { color: #64748b; font-size: 0.72rem; line-height: 1.4; }

  @media (max-width: 991.98px) {
    .allowance-sector-note { width: 100%; margin-left: 0; }
  }
  @media (max-width: 767.98px) {
    .allowance-header { flex-direction: column; }
    .allowance-header-actions { width: 100%; }
    .allowance-header-actions .btn { width: 100%; }
    .allowance-select-wrap { flex: 1 1 220px; min-width: 0; }
    .allowance-footer { align-items: stretch; }
    .allowance-footer .btn { width: 100%; }
  }
</style>

<script>
(function () {
  var presets = <%- JSON.stringify(taxPresets || {}) %>;
  var regSel = document.getElementById('cnpsRegimeSelect');
  var secSel = document.getElementById('activitySectorSelect');
  var titleEl = document.getElementById('taxPresetTitle');
  var noteEl = document.getElementById('taxPresetNote');
  var sectorNoteEl = document.getElementById('taxPresetSectorNote');
  var applyBtn = document.getElementById('applyTaxPreset');
  if (!regSel || !secSel) return;

  function currentPreset() {
    return presets[regSel.value + '|' + secSel.value] || null;
  }

  function setValue(name, value) {
    var input = document.querySelector('input[name="' + name + '"]');
    if (input && value != null) input.value = value;
  }

  function syncIrppFroms() {
    document.querySelectorAll('[data-irpp-from]').forEach(function (input, index) {
      if (index === 0) return;
      var previous = document.querySelector('input[name="tax_max_' + index + '"]');
      var value = previous ? parseFloat(previous.value) : NaN;
      input.value = Number.isFinite(value) ? (Math.round(value) + 1).toLocaleString('en-US') : '—';
    });
  }

  function render(p) {
    if (!p) return;
    if (titleEl) titleEl.textContent = p.regimeLabel + ' \u00b7 ' + p.sectorLabel;
    if (noteEl) noteEl.textContent = p.note || '';
    if (sectorNoteEl) sectorNoteEl.textContent = p.sectorNote || '';
  }

  function applyPreset() {
    var p = currentPreset();
    if (!p) return;
    setValue('cnps_employee_rate', p.rates.cnps_employee_rate);
    setValue('cimr_employee_rate', p.rates.cimr_employee_rate);
    setValue('development_tax_rate', p.rates.development_tax_rate);
    setValue('crtv_rate', p.rates.crtv_rate);
    setValue('council_tax_rate', p.rates.council_tax_rate);
    setValue('cnhc_rate', p.rates.cnhc_rate);
    (p.irppBrackets || []).forEach(function (bracket, i) {
      if (i < 3 && bracket.max != null) setValue('tax_max_' + (i + 1), bracket.max);
    });
    (p.irppRates || []).forEach(function (rate, i) { setValue('tax_rate_' + (i + 1), rate); });
    syncIrppFroms();
    render(p);
    if (noteEl) {
      noteEl.textContent = 'Applied ' + p.regimeLabel + ' \u00b7 ' + p.sectorLabel + ' statutory defaults. ' + (p.note || '') + ' Adjust any field before saving.';
    }
  }

  document.querySelectorAll('input[name^="tax_max_"]').forEach(function (input) {
    input.addEventListener('input', syncIrppFroms);
  });
  syncIrppFroms();
  regSel.addEventListener('change', applyPreset);
  secSel.addEventListener('change', applyPreset);
  if (applyBtn) applyBtn.addEventListener('click', applyPreset);
  render(currentPreset());
})();

/** Show only the rate control that matches each row's selected formula. */
(function () {
  function syncAllowanceRate(row) {
    var select = row.querySelector('[data-allowance-calc]');
    if (!select) return;
    var type = select.value;
    row.querySelectorAll('[data-amount-for]').forEach(function (field) {
      var matches = (field.getAttribute('data-amount-for') || '').split(/\s+/).indexOf(type) !== -1;
      field.hidden = !matches;
    });
  }

  document.querySelectorAll('[data-allowance-row]').forEach(function (row) {
    var select = row.querySelector('[data-allowance-calc]');
    if (select) {
      select.addEventListener('change', function () { syncAllowanceRate(row); });
    }
    syncAllowanceRate(row);
  });
})();
</script>

<%- include('partials/payroll-layout-end') %>
