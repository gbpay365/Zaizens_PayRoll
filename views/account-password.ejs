<%- include('partials/payroll-layout-start', { payNavActive: 'password' }) %>
<%
var p = policy || {};
var me = (currentUser || {});
%>

<div class="sage-page-head">
  <div>
    <p class="sage-eyebrow">My account</p>
    <h1>Change password</h1>
    <p class="sage-sub">Choose a new password for @<%= me.username || '' %>. It must meet the organisation password policy.</p>
  </div>
</div>

<% if (forced) { %>
<div class="sage-alert sage-alert--warn" style="margin-bottom:16px;">
  <i class="fa fa-exclamation-triangle"></i>
  <div>
    <strong>A password change is required.</strong>
    <span>Your administrator has asked you to set a new password before you continue using Zaizens Payroll.</span>
  </div>
</div>
<% } %>

<div class="sage-form-layout">
  <form method="POST" action="/account/password" class="sage-card" novalidate>
    <div class="sage-card-head">
      <div><h2>New password</h2><p class="sage-card-sub">Minimum <%= p.password_min_length || 8 %> characters<%= p.password_require_digit ? ', one number' : '' %><%= p.password_require_upper ? ', one uppercase letter' : '' %></p></div>
    </div>
    <div class="sage-card-body">
      <div class="sage-field">
        <label for="currentPassword">Current password</label>
        <input type="password" class="form-control" id="currentPassword" name="current_password" required autocomplete="current-password">
      </div>
      <div class="sage-field">
        <label for="newPassword">New password</label>
        <input type="password" class="form-control" id="newPassword" name="new_password" required autocomplete="new-password">
      </div>
      <div class="sage-field">
        <label for="confirmPassword">Confirm new password</label>
        <input type="password" class="form-control" id="confirmPassword" name="confirm_password" required autocomplete="new-password">
      </div>
      <p class="sage-hint mb-0">Passwords cannot contain spaces and must differ from your current password.</p>
    </div>
    <div class="sage-card-foot">
      <a href="<%= forced ? '/logout' : '/hr' %>" class="btn btn-sage-ghost"><%= forced ? 'Sign out' : 'Cancel' %></a>
      <button type="submit" class="btn btn-sage"><i class="fa fa-check mr-1"></i> Update password</button>
    </div>
  </form>

  <aside>
    <section class="sage-card">
      <div class="sage-card-head"><div><h2>Password policy</h2><p class="sage-card-sub">Set by your administrator</p></div></div>
      <div class="sage-card-body">
        <dl class="sage-list">
          <div class="sage-list-row"><dt>Minimum length</dt><dd><%= p.password_min_length || 8 %> characters</dd></div>
          <div class="sage-list-row"><dt>Number required</dt><dd><%= p.password_require_digit ? 'Yes' : 'No' %></dd></div>
          <div class="sage-list-row"><dt>Uppercase required</dt><dd><%= p.password_require_upper ? 'Yes' : 'No' %></dd></div>
          <div class="sage-list-row"><dt>Spaces allowed</dt><dd>No</dd></div>
        </dl>
        <p class="sage-hint mb-0">Use a mix of letters and numbers that you do not use on other systems.</p>
      </div>
    </section>
  </aside>
</div>

<style>
  .sage-form-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  @media (max-width: 1000px) { .sage-form-layout { grid-template-columns: minmax(0, 1fr); } }
</style>

<%- include('partials/payroll-layout-end') %>
