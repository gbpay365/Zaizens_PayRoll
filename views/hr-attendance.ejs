<%- include('partials/payroll-layout-start', { payNavActive: 'hratt', showHrLeaveAdmin: true }) %>
<%
var _s = summary || { present: 0, late: 0, absent: 0, 'half-day': 0, 'on-leave': 0, saved: 0 };
var _staff = staff || [];
var _dateLabel = new Date(String(date) + 'T12:00:00');
if (isNaN(_dateLabel.getTime())) _dateLabel = new Date();
%>

<div class="sage-page-head">
  <div>
    <p class="sage-eyebrow"><%= company.legalName %> &middot; HR &middot; Attendance</p>
    <h1>Attendance register</h1>
    <p class="sage-sub"><%= _dateLabel.toLocaleDateString('en-GB', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' }) %> &middot; record presence and hours for the payroll period.</p>
  </div>
  <div class="sage-head-actions no-print">
    <form action="/hr/attendance" method="GET" class="d-flex align-items-center" style="gap:8px;">
      <input type="date" name="date" class="form-control" style="width:160px;" value="<%= date %>" aria-label="Attendance date">
      <button type="submit" class="btn btn-sage-ghost">Fetch date</button>
    </form>
    <a href="/hr" class="btn btn-sage-ghost"><i class="fa fa-home mr-1"></i> HR overview</a>
  </div>
</div>

<div class="sage-stats">
  <div class="sage-stat">
    <div class="sage-stat-label">Present</div>
    <div class="sage-stat-value"><%= _s.present || 0 %></div>
    <p class="sage-stat-foot">Including late arrivals</p>
  </div>
  <div class="sage-stat">
    <div class="sage-stat-label">Late</div>
    <div class="sage-stat-value"><%= _s.late || 0 %></div>
    <p class="sage-stat-foot">Flagged on this date</p>
  </div>
  <div class="sage-stat sage-stat--warn">
    <div class="sage-stat-label">Absent</div>
    <div class="sage-stat-value"><%= _s.absent || 0 %></div>
    <p class="sage-stat-foot">Not present</p>
  </div>
  <div class="sage-stat">
    <div class="sage-stat-label">On leave</div>
    <div class="sage-stat-value"><%= _s['on-leave'] || 0 %></div>
    <p class="sage-stat-foot"><%= _s.saved || 0 %> row(s) already saved</p>
  </div>
</div>

<section class="sage-card">
  <div class="sage-card-head">
    <div>
      <h2>Daily register</h2>
      <p class="sage-card-sub"><%= _staff.length %> active employees</p>
    </div>
    <div class="pay-toolbar no-print">
      <input type="search" id="attendanceSearch" class="pay-search" placeholder="Filter staff…" aria-label="Filter staff" autocomplete="off">
      <button type="button" id="markAllPresent" class="btn btn-sage-ghost btn-sm">Mark all present</button>
    </div>
  </div>
  <form action="/hr/attendance/save" method="POST">
    <input type="hidden" name="date" value="<%= date %>">
    <div class="pay-table-wrap">
      <table class="pay-table" id="attendanceTable">
        <thead>
          <tr>
            <th>Employee</th>
            <th style="min-width:150px;">Status</th>
            <th style="min-width:130px;">Check in</th>
            <th style="min-width:130px;">Check out</th>
            <th class="pay-num">Hours</th>
          </tr>
        </thead>
        <tbody>
          <% if (!_staff.length) { %>
          <tr><td colspan="5" class="sage-empty"><i class="fa fa-users"></i>No active employees.</td></tr>
          <% } %>
          <% _staff.forEach(function (emp) {
            var ex = existing[emp.id] || {};
            var st = ex.status || 'present';
            var cin = ex.check_in_time ? String(ex.check_in_time).substring(0, 5) : '08:00';
            var cout = ex.check_out_time ? String(ex.check_out_time).substring(0, 5) : '17:00';
            var initials = ((emp.first_name || '?').charAt(0) + (emp.last_name || '').charAt(0)).toUpperCase();
          %>
          <tr data-search="<%= [emp.first_name, emp.last_name, emp.id].join(' ').toLowerCase() %>">
            <td>
              <div class="d-flex align-items-center" style="gap:10px;">
                <span class="sage-person-avatar"><%= initials %></span>
                <span>
                  <strong style="font-weight:600;"><%= emp.first_name %> <%= emp.last_name %></strong>
                  <small class="d-block text-muted">Employee #<%= emp.id %></small>
                </span>
              </div>
            </td>
            <td>
              <select name="attendance[<%= emp.id %>][status]" class="form-control form-control-sm att-status">
                <option value="present" <%= st === 'present' ? 'selected' : '' %>>Present</option>
                <option value="late" <%= st === 'late' ? 'selected' : '' %>>Late</option>
                <option value="absent" <%= st === 'absent' ? 'selected' : '' %>>Absent</option>
                <option value="half-day" <%= st === 'half-day' ? 'selected' : '' %>>Half day</option>
                <option value="on-leave" <%= st === 'on-leave' ? 'selected' : '' %>>On leave</option>
              </select>
            </td>
            <td><input type="time" name="attendance[<%= emp.id %>][in]" class="form-control form-control-sm att-time" value="<%= cin %>" aria-label="Check in for <%= emp.first_name %>"></td>
            <td><input type="time" name="attendance[<%= emp.id %>][out]" class="form-control form-control-sm att-time" value="<%= cout %>" aria-label="Check out for <%= emp.first_name %>"></td>
            <td class="pay-num sage-muted att-hours">9h</td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="sage-card-foot">
      <span class="sage-muted" style="font-size:12px;">Attendance is available to payroll and leave reporting but does not change salary automatically.</span>
      <button type="submit" class="btn btn-sage"><i class="fa fa-save mr-1"></i> Save attendance</button>
    </div>
  </form>
</section>

<style>
  .sage-person-avatar {
    width: 30px; height: 30px; border-radius: 50%; background: #e7f3ec; color: #006b3d;
    font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .att-status { max-width: 160px; }
  .att-time { max-width: 120px; }
</style>

<script>
(function () {
  var table = document.getElementById('attendanceTable');
  var input = document.getElementById('attendanceSearch');
  var markAll = document.getElementById('markAllPresent');
  if (!table) return;

  function rows() {
    return Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-search]'));
  }
  function recalc(row) {
    var cin = row.querySelector('input[name$="[in]"]');
    var cout = row.querySelector('input[name$="[out]"]');
    var out = row.querySelector('.att-hours');
    if (!cin || !cout || !out) return;
    if (!cin.value || !cout.value) { out.textContent = '—'; return; }
    var a = cin.value.split(':').map(Number);
    var b = cout.value.split(':').map(Number);
    var mins = (b[0] * 60 + b[1]) - (a[0] * 60 + a[1]);
    out.textContent = mins > 0 ? (Math.round(mins / 6) / 10) + 'h' : '—';
  }

  rows().forEach(function (row) {
    var cin = row.querySelector('input[name$="[in]"]');
    var cout = row.querySelector('input[name$="[out]"]');
    if (cin) cin.addEventListener('change', function () { recalc(row); });
    if (cout) cout.addEventListener('change', function () { recalc(row); });
    recalc(row);
  });

  if (input) {
    input.addEventListener('input', function () {
      var q = (input.value || '').trim().toLowerCase();
      rows().forEach(function (row) {
        var hay = row.getAttribute('data-search') || '';
        row.style.display = !q || hay.indexOf(q) !== -1 ? '' : 'none';
      });
    });
  }

  if (markAll) {
    markAll.addEventListener('click', function () {
      rows().forEach(function (row) {
        var sel = row.querySelector('.att-status');
        if (sel) sel.value = 'present';
      });
    });
  }
})();
</script>

<%- include('partials/payroll-layout-end') %>
