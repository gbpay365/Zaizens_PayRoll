PORT=3010
SESSION_SECRET=change-me-zaizens-payroll

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zaizens_payroll

PAYROLL_SELF_SERVICE_ENABLED=1

# Public URL of this PayRoll app (for partner integration UIs; use HTTPS when remote)
# PUBLIC_BASE_URL=https://payroll.example.com
# HMS_URL=https://hms.example.com

# One-way replication Zaizens PayRoll → Account_Core (fallback when DB settings empty)
CORE_ACCOUNT_SYNC_ENABLED=0
CORE_ACCOUNT_URL=http://127.0.0.1:5072
CORE_ACCOUNT_WEBHOOK_KEY=dev-integration-key-change-in-production
CORE_ACCOUNT_FACILITY_ID=1

# Inbound employee replication from HMS (one-way)
HMS_INTEGRATION_API_KEY=dev-hms-inbound-key-change-in-production
HMS_URL=http://127.0.0.1:3003

# HMS source database (for migrate:from-hms)
HMS_DB_HOST=127.0.0.1
HMS_DB_PORT=3306
HMS_DB_USER=root
HMS_DB_PASSWORD=
HMS_DB_NAME=hms

# Attendance device (biometric) clock ingestion — POST /api/attendance/punch
ATTENDANCE_DEVICE_TOKEN=dev-attendance-device-token-change-in-production
ATTENDANCE_DEVICE_FACILITY_ID=1

# SMTP for scheduled HR maintenance. Both the daily digest and the failure alert are
# skipped (logged, not fatal) while SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
# 1 = implicit TLS (port 465 is treated as secure automatically)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender, e.g. "Zaizens PayRoll <payroll@example.com>"; also the fallback alert address
SMTP_FROM=

# HR mailbox(es) for the daily leave-maintenance digest and failure alerts.
# Comma-, semicolon- or space-separated; falls back to the address inside SMTP_FROM when empty.
HR_MAINTENANCE_NOTIFY_EMAILS=
# Daily carry-over + accrual: enable the in-process scheduler, the hour it may run (0-23,
# server time) and how often it checks, in minutes (minimum 5).
HR_MAINTENANCE_SCHEDULER_ENABLED=1
HR_MAINTENANCE_HOUR=3
HR_MAINTENANCE_INTERVAL_MINUTES=60
