<%- include('partials/payroll-layout-start', { payNavActive: 'leaveadmin', showHrLeaveAdmin: true }) %>
<%
var _nums = function (n) { return (Number(n) || 0).toLocaleString('fr-FR', { maximumFractionDigits: 1 }); };
var _rows = rows || [];
var _totals = totals || { entitled: 0, used: 0, pending: 0, remaining: 0 };
%>

<div class="sage-page-head">
  <div>
    <p class="sage-eyebrow"><%= company.legalName %> &middot; HR &middot; Time off</p>
    <h1>Leave balances</h1>
    <p class="sage-sub">Set the annual entitlement per employee. Taken and pending days come from approved and waiting requests.</p>
  </div>
  <div class="sage-head-actions no-print">
    <form method="GET" action="/hr/leave-balances" class="d-flex align-items-center" style="gap:8px;">
      <label class="mb-0 sage-muted" style="font-size:12px;">Year</label>
      <select name="year" class="form-control" style="width:100px;" onchange="this.form.submit()">
        <% var cy = new Date().getFullYear(); for (var y = cy - 2; y <= cy + 2; y++) { %>
        <option value="<%= y %>" <%= Number(year) === y ? 'selected' : '' %>><%= y %></option>
        <% } %>
      </select>
    </form>
    <a href="/hr/leave-requests" class="btn btn-sage-ghost"><i class="fa fa-inbox mr-1"></i> Requests</a>
  </div>
</div>

<div class="sage-stats">
  <div class="sage-stat">
    <div class="sage-stat-label">Entitlement</div>
    <div class="sage-stat-value"><%= _nums(_totals.entitled) %></div>
    <p class="sage-stat-foot">Days across <%= _rows.length %> employees</p>
  </div>
  <div class="sage-stat">
    <div class="sage-stat-label">Taken</div>
    <div class="sage-stat-value"><%= _nums(_totals.used) %></div>
    <p class="sage-stat-foot">Approved in <%= year %></p>
  </div>
  <div class="sage-stat sage-stat--warn">
    <div class="sage-stat-label">Pending</div>
    <div class="sage-stat-value"><%= _nums(_totals.pending) %></div>
    <p class="sage-stat-foot">Waiting for approval</p>
  </div>
  <div class="sage-stat">
    <div class="sage-stat-label">Remaining</div>
    <div class="sage-stat-value"><%= _nums(_totals.remaining) %></div>
    <p class="sage-stat-foot">Entitlement − taken − pending</p>
  </div>
</div>

<section class="sage-card">
  <div class="sage-card-head">
    <div><h2>Annual entitlement <%= year %></h2><p class="sage-card-sub">Enter days; the remaining column updates when you save</p></div>
    <div class="pay-toolbar no-print">
      <input type="search" id="balanceSearch" class="pay-search" placeholder="Filter employee…" aria-label="Filter employees" autocomplete="off">
    </div>
  </div>
  <form method="POST" action="/hr/leave-balances/save">
    <input type="hidden" name="year" value="<%= year %>">
    <div class="pay-table-wrap">
      <table class="pay-table" id="balanceTable">
        <thead>
          <tr>
            <th>Employee</th>
            <th>Ref</th>
            <th class="pay-num">Entitlement (days)</th>
            <th class="pay-num">Taken</th>
            <th class="pay-num">Pending</th>
            <th class="pay-num">Remaining</th>
          </tr>
        </thead>
        <tbody>
          <% if (!_rows.length) { %>
          <tr><td colspan="6" class="sage-empty"><i class="fa fa-users"></i>No active employees.</td></tr>
          <% } %>
          <% _rows.forEach(function (r) {
            var eid = parseInt(r.id, 10) || 0;
            var initials = ((r.first_name || '?').charAt(0) + (r.last_name || '').charAt(0)).toUpperCase();
          %>
          <tr data-search="<%= [r.first_name, r.last_name, r.employee_ref, r.employee_id].filter(Boolean).join(' ').toLowerCase() %>">
            <td>
              <div class="d-flex align-items-center" style="gap:10px;">
                <span class="sage-person-avatar"><%= initials %></span>
                <span>
                  <a href="/payroll/employees/<%= eid %>" style="color:#16211c !important;text-decoration:none;font-weight:600;"><%= r.first_name %> <%= r.last_name %></a>
                  <% if (r.job_title || r.role_title) { %><small class="d-block text-muted"><%= r.job_title || r.role_title %></small><% } %>
                </span>
              </div>
            </td>
            <td class="sage-mono"><%= r.employee_ref || r.employee_id || eid %></td>
            <td class="pay-num" style="max-width:150px;">
              <input type="number" step="0.5" min="0" name="bal_<%= eid %>" class="form-control form-control-sm" style="max-width:110px;margin-left:auto;text-align:right;" value="<%= Number(r.balance || 0) %>" aria-label="Annual days for <%= r.first_name %> <%= r.last_name %>">
            </td>
            <td class="pay-num"><%= _nums(r.used) %></td>
            <td class="pay-num"><%= _nums(r.pending) %></td>
            <td class="pay-num"><strong><%= _nums(r.remaining) %></strong></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="sage-card-foot">
      <span class="sage-muted" style="font-size:12px;">Saving writes the annual entitlement for every employee on this page.</span>
      <button type="submit" class="btn btn-sage"><i class="fa fa-save mr-1"></i> Save balances</button>
    </div>
  </form>
</section>

<style>
  .sage-person-avatar {
    width: 30px; height: 30px; border-radius: 50%; background: #e7f3ec; color: #006b3d;
    font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
</style>

<script>
(function () {
  var input = document.getElementById('balanceSearch');
  var table = document.getElementById('balanceTable');
  if (!input || !table) return;
  var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-search]'));
  input.addEventListener('input', function () {
    var q = (input.value || '').trim().toLowerCase();
    rows.forEach(function (tr) {
      var hay = tr.getAttribute('data-search') || '';
      tr.style.display = !q || hay.indexOf(q) !== -1 ? '' : 'none';
    });
  });
})();
</script>

<%- include('partials/payroll-layout-end') %>
