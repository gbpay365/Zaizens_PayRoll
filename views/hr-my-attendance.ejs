<%- include('partials/payroll-layout-start', { payNavActive: 'attendance', paySelfServiceOnly: 'payslips' }) %>
<%
var _rows = rows || [];
var _s = summary || {};
var _fmtDate = function (d) {
  if (!d) return '—';
  var dt = new Date(String(d).slice(0, 10) + 'T12:00:00');
  if (isNaN(dt.getTime())) return String(d);
  return dt.toLocaleDateString('en-GB', { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' });
};
var _fmtTime = function (t) { return t ? String(t).substring(0, 5) : '—'; };
%>

<div class="sage-page-head">
  <div>
    <p class="sage-eyebrow"><%= company.legalName %> &middot; HR &middot; Attendance</p>
    <h1>My attendance</h1>
    <p class="sage-sub">Check-in history recorded by HR. Monthly totals cover the current calendar month.</p>
  </div>
  <div class="sage-head-actions no-print">
    <a href="/hr" class="btn btn-sage-ghost"><i class="fa fa-home mr-1"></i> HR overview</a>
  </div>
</div>

<div class="sage-stats">
  <div class="sage-stat">
    <div class="sage-stat-label">Recorded this month</div>
    <div class="sage-stat-value"><%= totalMonth || 0 %></div>
    <p class="sage-stat-foot">Days on the register</p>
  </div>
  <div class="sage-stat">
    <div class="sage-stat-label">Present</div>
    <div class="sage-stat-value"><%= _s.present || 0 %></div>
    <p class="sage-stat-foot">Including late arrivals</p>
  </div>
  <div class="sage-stat sage-stat--warn">
    <div class="sage-stat-label">Absent / late</div>
    <div class="sage-stat-value"><%= (_s.absent || 0) %> / <%= _s.late || 0 %></div>
    <p class="sage-stat-foot">This month</p>
  </div>
  <div class="sage-stat">
    <div class="sage-stat-label">Hours logged</div>
    <div class="sage-stat-value"><%= (Number(hoursMonth) || 0).toLocaleString('fr-FR', { maximumFractionDigits: 1 }) %></div>
    <p class="sage-stat-foot">From check-in / check-out</p>
  </div>
</div>

<section class="sage-card">
  <div class="sage-card-head">
    <div><h2>Attendance history</h2><p class="sage-card-sub">Most recent 120 records</p></div>
  </div>
  <div class="pay-table-wrap">
    <table class="pay-table">
      <thead>
        <tr><th>Date</th><th>Check in</th><th>Check out</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% if (!_rows.length) { %>
        <tr><td colspan="4" class="sage-empty"><i class="fa fa-clock-o"></i>No attendance recorded yet.</td></tr>
        <% } %>
        <% _rows.forEach(function (r) {
          var st = String(r.status || '').toLowerCase();
          var badge = st === 'present' ? 'pay-badge-paid' : (st === 'absent' ? 'pay-badge--error' : (st === 'late' || st === 'half-day' ? 'pay-badge-pending' : ''));
        %>
        <tr>
          <td><%= _fmtDate(r.att_date) %></td>
          <td class="sage-mono"><%= _fmtTime(r.check_in_time) %></td>
          <td class="sage-mono"><%= _fmtTime(r.check_out_time) %></td>
          <td><span class="pay-badge <%= badge %>"><%= st ? st.charAt(0).toUpperCase() + st.slice(1) : '—' %></span></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/payroll-layout-end') %>
