<%- include('partials/payroll-layout-start', { payNavActive: 'leavebal', paySelfServiceOnly: 'leave' }) %>
<%
var _t = (typeof t === 'function' ? t : function (k, o) { return (o && o.defaultValue != null) ? o.defaultValue : k; });
var _nums = function (n) { return (Number(n) || 0).toLocaleString('fr-FR', { maximumFractionDigits: 1 }); };
var _leaveLabel = function (t) {
  var map = { annual: 'Annual leave', sick: 'Sick leave', unpaid: 'Unpaid leave', other: 'Other leave' };
  return map[t] || String(t || '').replace(/_/g, ' ');
};
var _rows = rows || [];
var _totals = totals || { entitled: 0, used: 0, pending: 0, remaining: 0 };
%>

<div class="sage-page-head">
  <div>
    <p class="sage-eyebrow"><%= company.legalName %> &middot; HR &middot; Time off</p>
    <h1>My leave balance</h1>
    <p class="sage-sub">Entitlement, approved time taken and requests still waiting, for <%= year %>.</p>
  </div>
  <div class="sage-head-actions no-print">
    <form method="GET" action="/hr/my-leave-balance" class="d-flex align-items-center" style="gap:8px;">
      <label class="mb-0 sage-muted" style="font-size:12px;">Year</label>
      <select name="year" class="form-control" style="width:100px;" onchange="this.form.submit()">
        <% var cy = new Date().getFullYear(); for (var y = cy - 2; y <= cy + 2; y++) { %>
        <option value="<%= y %>" <%= Number(year) === y ? 'selected' : '' %>><%= y %></option>
        <% } %>
      </select>
    </form>
    <a href="/hr/request-leave" class="btn btn-sage"><i class="fa fa-paper-plane mr-1"></i> Request time off</a>
  </div>
</div>

<div class="sage-stats">
  <div class="sage-stat">
    <div class="sage-stat-label">Entitlement</div>
    <div class="sage-stat-value"><%= _nums(_totals.entitled) %></div>
    <p class="sage-stat-foot">Days for <%= year %></p>
  </div>
  <div class="sage-stat">
    <div class="sage-stat-label">Taken</div>
    <div class="sage-stat-value"><%= _nums(_totals.used) %></div>
    <p class="sage-stat-foot">Approved leave days</p>
  </div>
  <div class="sage-stat sage-stat--warn">
    <div class="sage-stat-label">Pending</div>
    <div class="sage-stat-value"><%= _nums(_totals.pending) %></div>
    <p class="sage-stat-foot">Awaiting approval</p>
  </div>
  <div class="sage-stat">
    <div class="sage-stat-label">Remaining</div>
    <div class="sage-stat-value"><%= _nums(_totals.remaining) %></div>
    <p class="sage-stat-foot">After taken and pending</p>
  </div>
</div>

<section class="sage-card">
  <div class="sage-card-head">
    <div><h2>Balances by leave type</h2><p class="sage-card-sub">Updated when HR approves leave</p></div>
  </div>
  <div class="pay-table-wrap">
    <table class="pay-table">
      <thead>
        <tr>
          <th>Leave type</th>
          <th class="pay-num">Entitlement</th>
          <th class="pay-num">Taken</th>
          <th class="pay-num">Pending</th>
          <th class="pay-num">Remaining</th>
          <th style="min-width:180px;">Usage</th>
        </tr>
      </thead>
      <tbody>
        <% if (!_rows.length) { %>
        <tr><td colspan="6" class="sage-empty"><i class="fa fa-balance-scale"></i>No balance rows for <%= year %>. Ask HR to set your entitlement.</td></tr>
        <% } %>
        <% _rows.forEach(function (r) {
          var entitled = Number(r.entitled != null ? r.entitled : r.balance) || 0;
          var used = Number(r.used) || 0;
          var pending = Number(r.pending) || 0;
          var remaining = r.remaining != null ? Number(r.remaining) : entitled - used - pending;
          var pct = entitled > 0 ? Math.min(100, Math.max(0, Math.round((used / entitled) * 100))) : 0;
        %>
        <tr>
          <td><strong style="font-weight:600;"><%= _leaveLabel(r.leave_type) %></strong></td>
          <td class="pay-num"><%= _nums(entitled) %></td>
          <td class="pay-num"><%= _nums(used) %></td>
          <td class="pay-num"><%= _nums(pending) %></td>
          <td class="pay-num"><strong><%= _nums(remaining) %></strong></td>
          <td>
            <div class="sage-progress"><span style="width:<%= pct %>%"></span></div>
            <small class="sage-muted"><%= pct %>% used</small>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <div class="sage-card-foot">
    <span class="sage-muted" style="font-size:12px;">Balances are managed by HR under Leave balances.</span>
    <a href="/hr" class="btn btn-sage-ghost btn-sm">HR overview</a>
  </div>
</section>

<%- include('partials/payroll-layout-end') %>
