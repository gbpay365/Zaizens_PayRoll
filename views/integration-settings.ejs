<%- include('partials/payroll-layout-start', { payNavActive: 'integrations', canPayrollSettings: true }) %>
<% var _t = (typeof t === 'function' ? t : function (k, o) { return (o && o.defaultValue != null) ? o.defaultValue : k; }); %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-4">
  <div>
    <h4 class="page-title font-weight-bold text-dark mb-1">Integration &amp; API settings</h4>
    <p class="text-muted small mb-0">Configure cross-platform URLs and API keys per facility. Use public HTTPS URLs when apps run on different servers.</p>
  </div>
  <span class="badge <%= settings.enabled ? 'badge-success' : 'badge-secondary' %> align-self-start"><%= settings.enabled ? 'Integrations enabled' : 'Integrations disabled' %></span>
</div>

<%- include('partials/admin-tabs') %>

<% if(locals.flash){ %>
<div class="alert alert-success border-0 shadow-sm mb-3 alert-dismissible"><%= flash %><button type="button" class="close" data-dismiss="alert"><span>&times;</span></button></div>
<% } %>
<% if(locals.error){ %>
<div class="alert alert-danger border-0 shadow-sm mb-3 alert-dismissible"><%= error %><button type="button" class="close" data-dismiss="alert"><span>&times;</span></button></div>
<% } %>

<div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
  <div class="card-body p-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
      <div>
        <h2 class="h6 font-weight-bold mb-1">Facilities (tenants)</h2>
        <p class="text-muted small mb-0">Each facility keeps its own payroll, employees and integration credentials.</p>
      </div>
      <span class="badge badge-light border"><%= (facilities || []).length %> facility(ies)</span>
    </div>
    <div class="table-responsive mb-3">
      <table class="table table-sm mb-0">
        <thead>
          <tr><th>ID</th><th>Code</th><th>Name</th><th>Status</th><th>Public URL</th><th></th></tr>
        </thead>
        <tbody>
          <% (facilities || []).forEach(function (f) { %>
          <tr<%= selectedId == f.id ? ' class="table-active"' : '' %>>
            <td><%= f.id %></td>
            <td><%= f.code || '—' %></td>
            <td class="font-weight-bold"><%= f.name || '—' %></td>
            <td>
              <% if (Number(f.status) === 1) { %>
              <span class="badge badge-success">Active</span>
              <% } else { %>
              <span class="badge badge-secondary">Inactive</span>
              <% } %>
            </td>
            <td class="small text-muted text-break"><%= f.public_base_url || '—' %></td>
            <td class="text-right">
              <% if (selectedId != f.id) { %>
              <a href="/payroll/integrations?facility_id=<%= f.id %>" class="btn btn-outline-secondary btn-sm">Configure</a>
              <% } else { %>
              <span class="text-success small font-weight-bold">Selected</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <form method="POST" action="/payroll/integrations/facilities" class="border-top pt-3">
      <h3 class="h6 font-weight-bold mb-2">Create a facility</h3>
      <div class="form-row">
        <div class="form-group col-md-5">
          <label class="small font-weight-bold text-muted text-uppercase" for="newFacilityName">Facility name</label>
          <input type="text" class="form-control" id="newFacilityName" name="name" maxlength="255" required placeholder="e.g. Caminco Mining — Site B">
        </div>
        <div class="form-group col-md-3">
          <label class="small font-weight-bold text-muted text-uppercase" for="newFacilityCode">Code (optional)</label>
          <input type="text" class="form-control" id="newFacilityCode" name="code" maxlength="32" placeholder="e.g. SITEB">
        </div>
        <div class="form-group col-md-4">
          <label class="small font-weight-bold text-muted text-uppercase" for="newFacilityUrl">Public URL (optional)</label>
          <input type="url" class="form-control" id="newFacilityUrl" name="public_base_url" maxlength="512" placeholder="https://payroll.example.com">
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-sm font-weight-bold"><i class="fa fa-plus mr-1"></i>Create facility</button>
      <small class="text-muted ml-2">New facilities start with integrations and the API enabled.</small>
    </form>
  </div>
</div>

<form method="POST" action="/payroll/integrations" class="mb-4">
  <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-4">
      <h2 class="h6 font-weight-bold mb-1">Integration switches</h2>
      <p class="text-muted small mb-3">Turn the whole integration layer off without deleting any configuration. Disabled integrations reject incoming API calls and skip outbound payroll sync.</p>
      <div class="custom-control custom-switch mb-2">
        <input type="checkbox" class="custom-control-input" id="integrationsEnabled" name="enabled" value="1" <%= settings.enabled ? 'checked' : '' %>>
        <label class="custom-control-label font-weight-bold" for="integrationsEnabled">Enable integrations for this facility</label>
      </div>
      <div class="custom-control custom-switch mb-2">
        <input type="checkbox" class="custom-control-input" id="apiEnabled" name="api_enabled" value="1" <%= settings.api_enabled ? 'checked' : '' %>>
        <label class="custom-control-label" for="apiEnabled">Allow API access for this facility <span class="text-muted small">(inbound employee endpoints)</span></label>
      </div>
      <div class="custom-control custom-switch">
        <input type="checkbox" class="custom-control-input" id="hmsSyncEnabled" name="hms_sync_enabled" value="1" <%= settings.hms_sync_enabled ? 'checked' : '' %>>
        <label class="custom-control-label" for="hmsSyncEnabled">Accept employee updates pushed from HMS</label>
      </div>
      <div class="mt-3">
        <button type="submit" class="btn btn-primary btn-sm font-weight-bold"><i class="fa fa-save mr-1"></i>Save switches</button>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-4">
      <h2 class="h6 font-weight-bold mb-3">Facility (tenant)</h2>
      <div class="form-row">
        <div class="form-group col-md-4">
          <label class="small font-weight-bold text-muted text-uppercase">Facility</label>
          <select name="facility_id" class="form-control" onchange="location.href='/payroll/integrations?facility_id='+this.value">
            <% (facilities || []).forEach(function(f){ %>
            <option value="<%= f.id %>" <%= selectedId == f.id ? 'selected' : '' %>><%= f.name || ('Facility ' + f.id) %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group col-md-8">
          <label class="small font-weight-bold text-muted text-uppercase">This app public URL</label>
          <input type="url" name="public_base_url" class="form-control" value="<%= settings.public_base_url || '' %>" placeholder="https://payroll.example.com">
          <small class="text-muted">HMS uses this to push employees. No trailing slash.</small>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-4">
      <h2 class="h6 font-weight-bold mb-3">Account_Core (outbound payroll sync)</h2>
      <div class="form-group">
        <div class="custom-control custom-checkbox mb-3">
          <input type="checkbox" class="custom-control-input" id="coreSync" name="core_account_sync_enabled" value="1" <%= settings.core_account_sync_enabled ? 'checked' : '' %>>
          <label class="custom-control-label" for="coreSync">Enable payroll sync to Account_Core</label>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group col-md-6">
          <label class="small font-weight-bold text-muted text-uppercase">Account_Core API URL</label>
          <input type="url" name="core_account_url" class="form-control" value="<%= settings.core_account_url || '' %>" placeholder="https://accounting.example.com:5072">
        </div>
        <div class="form-group col-md-6">
          <label class="small font-weight-bold text-muted text-uppercase">Outbound API key (X-API-Key)</label>
          <input type="text" name="core_account_api_key" class="form-control" value="<%= settings.core_account_api_key || '' %>" autocomplete="off">
        </div>
      </div>
      <button type="submit" formaction="/payroll/integrations/test-core" formmethod="POST" class="btn btn-outline-secondary btn-sm">Test Account_Core</button>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-4">
      <h2 class="h6 font-weight-bold mb-3">HMS (inbound employee replication)</h2>
      <div class="form-row">
        <div class="form-group col-md-6">
          <label class="small font-weight-bold text-muted text-uppercase">HMS URL (for health checks)</label>
          <input type="url" name="hms_url" class="form-control" value="<%= settings.hms_url || '' %>" placeholder="http://127.0.0.1:3003">
          <small class="text-muted">Local HMS runs on port <strong>3003</strong> in this install (not 3000).</small>
        </div>
        <div class="form-group col-md-6">
          <label class="small font-weight-bold text-muted text-uppercase">Inbound API key (HMS must send this)</label>
          <input type="text" name="hms_api_key_inbound" class="form-control" value="<%= settings.hms_api_key_inbound || '' %>" autocomplete="off">
        </div>
      </div>
      <button type="submit" formaction="/payroll/integrations/test-hms" formmethod="POST" class="btn btn-outline-secondary btn-sm">Test HMS</button>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4" style="border-radius:14px;">
    <div class="card-body p-4">
      <h2 class="h6 font-weight-bold mb-3">Inbound endpoints (configure in HMS)</h2>
      <p class="small text-muted">Send header <code>X-API-Key</code> and <code>X-Facility-Id: <%= selectedId %></code></p>
      <ul class="small mb-0">
        <li><code>GET <%= inboundEndpoints.health %></code></li>
        <li><code>POST <%= inboundEndpoints.employees %></code></li>
        <li><code>POST <%= inboundEndpoints.employeesBulk %></code></li>
      </ul>
    </div>
  </div>

  <button type="submit" class="btn btn-success font-weight-bold">Save integration settings</button>
</form>

<%- include('partials/payroll-layout-end') %>
