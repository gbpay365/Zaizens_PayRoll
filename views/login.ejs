<%
var b = locals.brand || {};
var _lang = locals.lang || 'en';
var _t = locals.t || function (k, o) { return (o && o.defaultValue) || k; };
var err = (locals.pageData && locals.pageData.error) || locals.error || null;
var msg = (locals.pageData && locals.pageData.msg) || locals.msg || null;
%>
<!DOCTYPE html>
<html lang="<%= _lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0c2f25">
  <title>Sign in — Zaizens Payroll</title>
  <link rel="icon" type="image/svg+xml" href="<%= b.faviconPath || '/img/zaizens-favicon.svg' %>">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="/css/sage.css">
</head>
<body>
  <div class="sage-login">
    <section class="sage-login-brand">
      <div class="sage-login-mark"><span>Z</span> Zaizens Payroll</div>
      <div class="sage-login-copy">
        <h1>Payroll that keeps Cameroon compliance in step.</h1>
        <p>Run monthly payroll, produce payslips and file CNPS, DGI and statutory returns from one register.</p>
        <ul class="sage-login-points">
          <li><i class="fa fa-check-circle"></i> CNPS, CFC, CRTV, FNE, IRPP and CAC calculated automatically</li>
          <li><i class="fa fa-check-circle"></i> Gross to net, with housing, transport and role allowances</li>
          <li><i class="fa fa-check-circle"></i> Payslips, payroll runs and tax declarations in one place</li>
        </ul>
      </div>
      <p class="sage-login-foot">&copy; <%= new Date().getFullYear() %> Zaizens Payroll &middot; Cameroon</p>
    </section>

    <section class="sage-login-panel">
      <div class="sage-login-form">
        <h2>Sign in</h2>
        <p class="sage-login-sub">Use your payroll account to continue.</p>

        <% if (err) { %>
        <div class="alert alert-danger mb-3"><i class="fa fa-exclamation-circle mr-1"></i><%= err %></div>
        <% } %>
        <% if (msg) { %>
        <div class="alert alert-success mb-3"><i class="fa fa-check-circle mr-1"></i><%= msg %></div>
        <% } %>

        <form method="POST" action="/login">
          <div class="sage-field">
            <label for="username">Username</label>
            <input type="text" class="form-control" id="username" name="username" required autofocus autocomplete="username" placeholder="e.g. payadmin">
          </div>
          <div class="sage-field">
            <label for="password">Password</label>
            <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password" placeholder="Your password">
          </div>
          <button type="submit" class="btn btn-sage btn-block mt-3">
            <i class="fa fa-sign-in mr-1"></i> Sign in
          </button>
        </form>

        <p class="sage-login-hint">Access is managed by your payroll administrator. If you were migrated from HMS, use the same staff username.</p>
      </div>
    </section>
  </div>
</body>
</html>
