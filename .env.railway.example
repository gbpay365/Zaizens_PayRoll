# Railway — Zaizens PayRoll (reference only; set in Railway dashboard)
#
# Link MySQL plugin, then set:
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# DB_NAME=${{MySQL.MYSQLDATABASE}}
#
# Or: DATABASE_URL=${{MySQL.MYSQL_URL}}
#
# DELETE any DB_HOST=127.0.0.1 copied from local .env on the Railway service.
#
# SESSION_SECRET=<long random>
# PUBLIC_BASE_URL=https://zaizenspay.up.railway.app
# CORE_ACCOUNT_URL=https://zaizens-account.up.railway.app
# CORE_ACCOUNT_SYNC_ENABLED=1
# CORE_ACCOUNT_WEBHOOK_KEY=<same as Account_Core Integrations:ApiKey>
# HMS_URL=https://zaizens-hms.up.railway.app
# HMS_INTEGRATION_API_KEY=<shared key>
