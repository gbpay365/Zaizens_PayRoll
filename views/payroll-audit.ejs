<%- include('partials/payroll-layout-start', { payNavActive: 'payroll-audit' }) %>
<%
var rows = auditRows || [];
var f = filters || {};
var _fmtWhen = function (v) {
  if (!v) return '—';
  var d = new Date(v);
  if (isNaN(d.getTime())) return String(v);
  return d.toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
};
var _actionLabel = function (a) {
  return String(a || '').replace(/^payroll\./, '').replace(/[._]/g, ' ').replace(/\b\w/g, function (ch) { return ch.toUpperCase(); });
};
var _empName = function (r) {
  var n = ((r.first_name || '') + ' ' + (r.last_name || '')).trim();
  return n || ('Employee #' + (r.target_id || ''));
};
var _iso = function (v) {
  if (!v) return '';
  var d = new Date(v);
  return isNaN(d.getTime()) ? '' : d.toISOString().slice(0, 10);
};
var hasFilters = !!(f.employee || f.action || f.from || f.to);
%>

<div class="sage-page-head">
  <div>
    <p class="sage-eyebrow">Payroll &middot; Audit</p>
    <h1>Payroll audit</h1>
    <p class="sage-sub">Every salary calculation, salary change and payroll undo recorded by the payroll module for the current facility. Entries are written by the server and cannot be edited here.</p>
  </div>
  <div class="sage-head-actions no-print">
    <a href="/admin/activity" class="btn btn-sage-ghost"><i class="fa fa-history mr-1"></i> All activity</a>
  </div>
</div>

<section class="sage-card no-print">
  <div class="sage-card-head">
    <div><h2>Filters</h2><p class="sage-card-sub">Narrow the trail by employee, action or date</p></div>
  </div>
  <form method="GET" action="/payroll/audit" class="pay-filter-form" style="padding:16px 18px;">
    <div class="form-row">
      <div class="form-group col-md-4">
        <label for="auditEmployee">Employee</label>
        <select id="auditEmployee" name="employee" class="form-control">
          <option value="">All employees</option>
          <% employeeOptions.forEach(function (e) { %>
          <option value="<%= e.id %>" <%= Number(f.employee) === Number(e.id) ? 'selected' : '' %>>
            <%= ((e.first_name || '') + ' ' + (e.last_name || '')).trim() || ('Employee #' + e.id) %><%= e.employee_id ? ' — ' + e.employee_id : '' %>
          </option>
          <% }); %>
        </select>
      </div>
      <div class="form-group col-md-4">
        <label for="auditAction">Action</label>
        <select id="auditAction" name="action" class="form-control">
          <option value="">All payroll actions</option>
          <% actionOptions.forEach(function (a) { %>
          <option value="<%= a.action %>" <%= f.action === a.action ? 'selected' : '' %>><%= _actionLabel(a.action) %> (<%= a.entry_count %>)</option>
          <% }); %>
        </select>
      </div>
      <div class="form-group col-md-2">
        <label for="auditFrom">From</label>
        <input type="date" id="auditFrom" name="from" class="form-control" value="<%= _iso(f.from) %>">
      </div>
      <div class="form-group col-md-2">
        <label for="auditTo">To</label>
        <input type="date" id="auditTo" name="to" class="form-control" value="<%= _iso(f.to) %>">
      </div>
    </div>
    <div class="d-flex align-items-center" style="gap:8px;">
      <button type="submit" class="btn btn-sage"><i class="fa fa-filter mr-1"></i> Apply filters</button>
      <% if (hasFilters) { %>
      <a href="/payroll/audit" class="btn btn-sage-ghost">Clear</a>
      <% } %>
    </div>
  </form>
</section>

<% if (filterError) { %>
<div class="alert alert-warning" role="alert" style="border-radius:10px;"><i class="fa fa-exclamation-triangle mr-1"></i> <%= filterError %></div>
<% } %>

<section class="sage-card">
  <div class="sage-card-head">
    <div>
      <h2>Payroll trail</h2>
      <p class="sage-card-sub"><%= total %> matching entr<%= total === 1 ? 'y' : 'ies' %><%= total > rows.length ? ' · showing latest ' + rows.length : '' %></p>
    </div>
  </div>
  <div class="pay-table-wrap">
    <table class="pay-table">
      <thead>
        <tr><th>When</th><th>Employee / target</th><th>Action</th><th>Detail</th><th>By</th><th>IP</th></tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
        <tr><td colspan="6" class="sage-empty"><i class="fa fa-history"></i>No payroll audit entries match these filters.</td></tr>
        <% } %>
        <% rows.forEach(function (a) { %>
        <tr>
          <td class="sage-muted" style="white-space:nowrap; font-size:12px;"><%= _fmtWhen(a.created_at) %></td>
          <td>
            <% if (a.target_type === 'employee' && a.target_id) { %>
              <a href="/payroll/employees/<%= a.target_id %>"><%= _empName(a) %></a>
              <% if (a.matricule) { %><small class="d-block text-muted"><%= a.matricule %></small><% } %>
            <% } else { %>
              <span class="sage-muted"><%= a.target_type ? a.target_type + ' ' + (a.target_id || '') : '—' %></span>
            <% } %>
          </td>
          <td><span class="pay-badge"><%= _actionLabel(a.action) %></span></td>
          <td style="font-size:12.5px;"><%= a.detail || '' %></td>
          <td><%= a.actor_name || 'System' %></td>
          <td class="sage-mono" style="font-size:11.5px;"><%= a.ip || '—' %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <div class="sage-card-foot">
    <span class="sage-muted" style="font-size:12px;">Read-only. Source table <span class="sage-mono">tbl_admin_audit</span> (actions starting with <span class="sage-mono">payroll.</span>).</span>
  </div>
</section>

<%- include('partials/payroll-layout-end') %>
